{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/**/*",
    "shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/renderer/src/*"],
      "shared/*": ["./shared/*"]
    }
  }
}
